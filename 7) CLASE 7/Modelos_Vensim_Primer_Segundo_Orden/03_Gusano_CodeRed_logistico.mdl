{UTF-8}
Susceptibles=
	INTEG (
			-Infecciones-Parcheo de susceptibles,
				Hosts vulnerables-Infectados iniciales)
	~	hosts
	~	
	|

Infectados=
	INTEG (
			Infecciones-Parcheo de infectados,
				Infectados iniciales)
	~	hosts
	~	Nivel: servidores IIS comprometidos.
	|

Protegidos=
	INTEG (
			Parcheo de susceptibles+Parcheo de infectados,
				0)
	~	hosts
	~	
	|

Infecciones=
	Tasa de contacto*Susceptibles*Infectados/Hosts vulnerables
	~	hosts/hora
	~	Crecimiento logístico: R al inicio, B al agotarse los susceptibles.
	|

Parcheo de susceptibles=
	Tasa de parcheo*Susceptibles*STEP(1, Inicio del parcheo)
	~	hosts/hora
	~	
	|

Parcheo de infectados=
	Tasa de parcheo*Infectados*STEP(1, Inicio del parcheo)
	~	hosts/hora
	~	
	|

Tasa de contacto=
	1.33
	~	1/hora
	~	Calibrada: pico de unos 2 000 hosts por minuto (CAIDA, 2001).
	|

Hosts vulnerables=
	360000
	~	hosts
	~	Más de 359 000 hosts infectados el 19 de julio de 2001 (CAIDA).
	|

Infectados iniciales=
	30
	~	hosts
	~	
	|

Tasa de parcheo=
	0
	~	1/hora
	~	Escenario: 0.5 desde la hora 4 o 6.
	|

Inicio del parcheo=
	4
	~	hora
	~	
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 16
	~	hora
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	hora
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	hora [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.0625
	~	hora [0,?]
	~	Paso de integración (método de Euler).
	|

