{UTF-8}
Tareas pendientes=
	INTEG (
			-Avance,
				Tamano del proyecto)
	~	tareas
	~	
	|

Novatos=
	INTEG (
			Contratacion-Asimilacion,
				0)
	~	personas
	~	
	|

Expertos=
	INTEG (
			Asimilacion,
				Expertos iniciales)
	~	personas
	~	
	|

Contratacion=
	Personas a contratar*PULSE(Dia de contratacion, TIME STEP)/TIME STEP
	~	personas/dia
	~	Ingreso de nuevos desarrolladores en un solo día.
	|

Asimilacion=
	Novatos/Tiempo de asimilacion
	~	personas/dia
	~	
	|

Tamano del equipo=
	Novatos+Expertos
	~	personas
	~	
	|

Sobrecarga de comunicacion=
	MIN(0.9, Coeficiente de comunicacion*(Tamano del equipo/10)^2)
	~	Dmnl
	~	Brooks: los canales de comunicación crecen como n(n-1)/2.
	|

Productividad bruta=
	MAX(0, (Expertos-Tiempo de mentoria*Novatos)*Productividad experto+Novatos*Productividad novato)
	~	tareas/dia
	~	Los novatos consumen tiempo de los expertos.
	|

Avance=
	IF THEN ELSE(Tareas pendientes>0, Productividad bruta*(1-Sobrecarga de comunicacion), 0)
	~	tareas/dia
	~	
	|

Tamano del proyecto=
	2000
	~	tareas
	~	
	|

Expertos iniciales=
	10
	~	personas
	~	
	|

Personas a contratar=
	0
	~	personas
	~	Escenarios: 10 personas el día 0, 100 o 150.
	|

Dia de contratacion=
	150
	~	dia
	~	
	|

Tiempo de asimilacion=
	60
	~	dia
	~	
	|

Coeficiente de comunicacion=
	0.08
	~	Dmnl
	~	
	|

Tiempo de mentoria=
	0.5
	~	Dmnl
	~	Fracción de un experto que consume cada novato.
	|

Productividad experto=
	1
	~	tareas/persona/dia
	~	
	|

Productividad novato=
	0.2
	~	tareas/persona/dia
	~	
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 400
	~	dia
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	dia
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	dia [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.25
	~	dia [0,?]
	~	Paso de integración (método de Euler).
	|

