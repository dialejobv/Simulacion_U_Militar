{UTF-8}
Tickets pendientes=
	INTEG (
			Llegadas-Resoluciones,
				Llegadas normales*Tiempo de resolucion)
	~	tickets
	~	Nivel: solicitudes sin resolver en la mesa de ayuda. Arranca en el equilibrio de la ley de Little.
	|

Llegadas=
	Llegadas normales+STEP(Llegadas en incidente-Llegadas normales, Hora del incidente)
	~	tickets/hora
	~	
	|

Resoluciones=
	Tickets pendientes/Tiempo de resolucion
	~	tickets/hora
	~	Salida proporcional al nivel: primer orden.
	|

Llegadas normales=
	40
	~	tickets/hora
	~	
	|

Llegadas en incidente=
	70
	~	tickets/hora
	~	Escenarios: optimista 55, pesimista 100.
	|

Hora del incidente=
	8
	~	hora
	~	
	|

Tiempo de resolucion=
	2
	~	hora
	~	Con más agentes baja a 1.4.
	|

Tiempo de espera estimado=
	Tickets pendientes/Llegadas
	~	hora
	~	Ley de Little: W = L / lambda.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 24
	~	hora
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	hora
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	hora [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.0625
	~	hora [0,?]
	~	Paso de integración (método de Euler).
	|

