{UTF-8}
Instancias en arranque=
	INTEG (
			Solicitud de instancias-Instancias listas,
				0)
	~	instancias
	~	Nivel 1: máquinas pedidas que aún no atienden tráfico.
	|

Instancias activas=
	INTEG (
			Instancias listas-Retiro de instancias,
				Demanda base/(Capacidad por instancia*Utilizacion objetivo))
	~	instancias
	~	Nivel 2: máquinas que atienden tráfico.
	|

Utilizacion medida=
	INTEG (
			(Utilizacion real-Utilizacion medida)/Tiempo de medicion,
				Utilizacion objetivo)
	~	Dmnl
	~	Métrica suavizada (retardo de información, como la ventana del HPA).
	|

Instancias listas=
	Instancias en arranque/Tiempo de arranque
	~	instancias/minuto
	~	
	|

Brecha de instancias=
	Instancias deseadas-Instancias activas-Considerar instancias en arranque*Instancias en arranque
	~	instancias
	~	
	|

Solicitud de instancias=
	MAX(Brecha de instancias/Tiempo de ajuste, 0)
	~	instancias/minuto
	~	
	|

Retiro de instancias=
	MAX(-Brecha de instancias/Tiempo de ajuste, 0)
	~	instancias/minuto
	~	
	|

Instancias deseadas=
	Instancias activas*Utilizacion medida/Utilizacion objetivo
	~	instancias
	~	Regla del HPA de Kubernetes: réplicas · métrica actual / métrica deseada.
	|

Utilizacion real=
	Demanda/(Capacidad por instancia*Instancias activas)
	~	Dmnl
	~	
	|

Demanda=
	Demanda base+(Demanda pico-Demanda base)*PULSE(Inicio del pico, Duracion del pico)
	~	solicitudes/segundo
	~	
	|

Demanda base=
	600
	~	solicitudes/segundo
	~	
	|

Demanda pico=
	1500
	~	solicitudes/segundo
	~	Campaña o día sin IVA.
	|

Inicio del pico=
	10
	~	minuto
	~	
	|

Duracion del pico=
	60
	~	minuto
	~	
	|

Capacidad por instancia=
	100
	~	solicitudes/segundo/instancia
	~	
	|

Utilizacion objetivo=
	0.7
	~	Dmnl
	~	
	|

Tiempo de ajuste=
	1
	~	minuto
	~	
	|

Tiempo de arranque=
	4
	~	minuto
	~	
	|

Tiempo de medicion=
	2
	~	minuto
	~	
	|

Considerar instancias en arranque=
	0
	~	Dmnl
	~	0 = regla ingenua (oscila); 1 = cuenta las instancias en camino.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	minuto
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	minuto
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	minuto [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.0625
	~	minuto [0,?]
	~	Paso de integración (método de Euler).
	|

