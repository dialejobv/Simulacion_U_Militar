{UTF-8}
Temperatura CPU=
	INTEG (
			Calentamiento-Enfriamiento,
				Temperatura ambiente+Potencia en reposo*Resistencia termica)
	~	C
	~	Nivel: temperatura del procesador. Arranca en el equilibrio de reposo.
	|

Calentamiento=
	Potencia/Capacidad termica
	~	C/s
	~	Flujo de entrada: la potencia disipada calienta el chip.
	|

Enfriamiento=
	(Temperatura CPU-Temperatura ambiente)/(Resistencia termica*Capacidad termica)
	~	C/s
	~	Flujo de salida: ley de enfriamiento de Newton.
	|

Potencia=
	Potencia en reposo+STEP(Potencia en carga-Potencia en reposo, Inicio de la carga)
	~	W
	~	Escalón de carga (por ejemplo, un renderizado).
	|

Potencia en reposo=
	15
	~	W
	~	
	|

Potencia en carga=
	95
	~	W
	~	
	|

Inicio de la carga=
	30
	~	s
	~	
	|

Resistencia termica=
	0.4
	~	C/W
	~	Disipador. Pruebe 0.75 (disipador sucio) o 0.25 (refrigeración líquida).
	|

Capacidad termica=
	50
	~	J/C
	~	Masa térmica del chip y el disipador.
	|

Temperatura ambiente=
	25
	~	C
	~	
	|

Constante de tiempo=
	Resistencia termica*Capacidad termica
	~	s
	~	tau = R·C. El 63 % del cambio ocurre en tau segundos.
	|

Temperatura de equilibrio=
	Temperatura ambiente+Potencia*Resistencia termica
	~	C
	~	Hacia donde se dirige la temperatura (objetivo del bucle B).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	s
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	s
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	s [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.5
	~	s [0,?]
	~	Paso de integración (método de Euler).
	|

