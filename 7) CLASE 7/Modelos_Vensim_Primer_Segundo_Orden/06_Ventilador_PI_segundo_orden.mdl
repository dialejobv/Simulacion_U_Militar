{UTF-8}
Temperatura servidor=
	INTEG (
			Cambio de temperatura,
				Temperatura objetivo inicial)
	~	C
	~	Nivel 1 del lazo cerrado.
	|

Error acumulado=
	INTEG (
			Acumulacion del error,
				Ventilador inicial/Ki)
	~	C*s
	~	Nivel 2: la acción integral del controlador PI.
	|

Cambio de temperatura=
	(Temperatura ambiente+Potencia*Resistencia termica-Efecto del ventilador*Velocidad del ventilador-Temperatura servidor)/Constante de tiempo
	~	C/s
	~	
	|

Error=
	Temperatura servidor-Temperatura objetivo
	~	C
	~	
	|

Temperatura objetivo=
	Temperatura objetivo inicial+STEP(Nuevo objetivo-Temperatura objetivo inicial, Momento del cambio)
	~	C
	~	
	|

Senal del controlador=
	Kp*Error+Ki*Error acumulado
	~	%
	~	
	|

Velocidad del ventilador=
	MAX(0, MIN(100, Senal del controlador))
	~	%
	~	
	|

Acumulacion del error=
	IF THEN ELSE(Senal del controlador>=100 :AND: Error>0, 0, IF THEN ELSE(Senal del controlador<=0 :AND: Error<0, 0, Error))
	~	C
	~	Anti-windup: deja de integrar si el ventilador está saturado.
	|

Ventilador inicial=
	(Temperatura ambiente+Potencia*Resistencia termica-Temperatura objetivo inicial)/Efecto del ventilador
	~	%
	~	
	|

Potencia=
	Potencia base+STEP(Potencia extra, Momento de la carga)
	~	W
	~	
	|

Kp=
	1.5
	~	%/C
	~	Agresivo: 0.3 · Bien ajustado: 1.5 · Lento: 1
	|

Ki=
	0.1
	~	%/(C*s)
	~	Agresivo: 0.15 · Bien ajustado: 0.1 · Lento: 0.01
	|

Temperatura objetivo inicial=
	60
	~	C
	~	
	|

Nuevo objetivo=
	50
	~	C
	~	
	|

Momento del cambio=
	50
	~	s
	~	
	|

Temperatura ambiente=
	25
	~	C
	~	
	|

Resistencia termica=
	0.4
	~	C/W
	~	
	|

Efecto del ventilador=
	0.3
	~	C/%
	~	
	|

Constante de tiempo=
	40
	~	s
	~	
	|

Potencia base=
	120
	~	W
	~	
	|

Potencia extra=
	0
	~	W
	~	Perturbación opcional.
	|

Momento de la carga=
	300
	~	s
	~	
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 600
	~	s
	~	Tiempo final de la simulación.
	|

INITIAL TIME  = 0
	~	s
	~	Tiempo inicial de la simulación.
	|

SAVEPER  = 
	TIME STEP
	~	s [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.125
	~	s [0,?]
	~	Paso de integración (método de Euler).
	|

